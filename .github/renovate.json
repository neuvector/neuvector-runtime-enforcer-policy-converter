{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": [
    "main"
  ],
  "packageRules": [
    {
      "matchBaseBranches": [
        "main"
      ],
      "extends": [
        "github>rancher/renovate-config#release"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/govulncheck\\.yml$/"],
      "matchStrings": [
        "GOVULNCHECK_VERSION: (?<currentDigest>[a-f0-9]{40}) # (?<currentValue>v[^\\s]+)"
      ],
      "depNameTemplate": "golang/vuln",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "github-actions",
      "autoReplaceStringTemplate": "GOVULNCHECK_VERSION: {{{newDigest}}} # {{{newValue}}}"
    }
  ]
}
